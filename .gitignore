# VS Code 配置（每台电脑不同，不要提交）
.vscode/

# IDE 配置
.claude/
.reasonix/

# 运行时数据（敏感，不提交；只存在于服务器）
data/*.json
data/*.hash
data/*.tmp*

# 上传目录
uploads/

# 下载资源：APK 体积大，不进 Git，只在服务器保留
# 发布新版本请走 GitHub Release，或直接上传到服务器 downloads/
downloads/*
!downloads/README.md

# 服务器配置片段
nginx-config-snippet.conf

# 压缩包
*.zip

# 系统文件
.DS_Store
Thumbs.db
*-shot.png

# 部署配置文件（包含本地路径等敏感信息）
.env
.env.local
